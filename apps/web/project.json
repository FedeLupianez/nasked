{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/web"
      },
      "configurations": {
        "local": {
          "mode": "dev_local"
        },
        "api": {
          "mode": "dev_api"
        }
      }
    },
    "dev": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "web:build"
      },
      "configurations": {
        "local": {
          "mode": "dev_local"
        },
        "api": {
          "mode": "dev_api"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "web:build"
      },
      "configurations": {
        "local": {
          "mode": "dev_local"
        },
        "api": {
          "mode": "dev_api"
        },
        "production": {}
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "web:build"
      }
    }
  }
}
